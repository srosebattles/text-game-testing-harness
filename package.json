{
  "name": "text-game-testing-harness",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "description": "Two-agent harness for testing text-based game skills: a GM agent runs the game, a persona agent plays it.",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "harness": "tsx src/run.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.233",
    "@anthropic-ai/sdk": "^0.117.1",
    "yaml": "^2.9.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0"
  }
}
